generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "fullTextIndex"] // ✅ For better search performance
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Uses pgbouncer (port 6543)
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  password           String
  role               UserRole            @default(USER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reports            Report[]
  uploads            Upload[]
  employeeComponents EmployeeComponent[] @relation("EmployeeComponentUploads")

  @@index([email])
  @@map("users")
}

model Component {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  type      ComponentType
  notes     String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([name])
  @@index([type, isActive])
  @@map("components")
}

model Upload {
  id           String       @id @default(cuid())
  fileName     String
  originalName String
  fileSize     Int
  rowCount     Int
  period       DateTime
  status       UploadStatus @default(PROCESSING)
  progress     Int          @default(0)
  errorMessage String?
  uploadedAt   DateTime     @default(now())
  userId       String
  employees    Employee[]
  reports      Report[]
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([period])
  @@map("uploads")
}

model Employee {
  id               String    @id @default(cuid())
  uploadId         String
  employeeNo       String
  name             String
  gender           String?
  noKTP            String?
  taxFileNo        String?
  position         String?
  directorate      String?
  orgUnit          String?
  grade            String?
  employmentStatus String?
  joinDate         DateTime?
  terminateDate    DateTime?
  lengthOfService  String?
  taxStatus        String?
  salaryData       Json
  allowanceData    Json
  deductionData    Json
  neutralData      Json
  createdAt        DateTime  @default(now())
  upload           Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([uploadId, employeeNo])
  @@index([uploadId])
  @@index([employeeNo])
  @@index([name])
  @@index([uploadId, employeeNo])
  @@map("employees")
}

model Report {
  id             String   @id @default(cuid())
  name           String
  description    String?
  reportType     String   @default("MONTHLY")
  uploadId       String
  userId         String
  selectedFields Json
  filters        Json?
  totalRecords   Int
  fileUrl        String?
  createdAt      DateTime @default(now())
  upload         Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([uploadId])
  @@index([createdAt])
  @@map("reports")
}

model EmployeeComponent {
  id          String   @id @default(cuid())
  employeeNo  String
  komponen    String
  nilai       String
  remark      String?
  remark2     String?
  remark3     String?
  bulanReport String
  type        String   @default("HO")
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  user        User     @relation("EmployeeComponentUploads", fields: [uploadedBy], references: [id], onDelete: Cascade)

  // ✅ CRITICAL: Optimized indexes for 950K rows
  @@index([employeeNo])
  @@index([bulanReport])
  @@index([uploadedBy])
  @@index([type])
  @@index([komponen])
  // ✅ Composite indexes for common queries (MOST IMPORTANT)
  @@index([employeeNo, komponen]) // For employee lookup
  @@index([bulanReport, type]) // For dashboard filters
  @@index([komponen, type]) // For chart queries
  @@index([komponen, bulanReport, type]) // For complex filters
  @@index([employeeNo, bulanReport]) // For deduplication queries
  @@map("employee_components")
}

enum UserRole {
  ADMIN
  USER
}

enum ComponentType {
  ALLOWANCE
  DEDUCTION
  NEUTRAL
}

enum UploadStatus {
  PROCESSING
  COMPLETED
  FAILED
}
